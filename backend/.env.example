# Copy to .env for Docker Compose; use unique secrets outside local development.
DB_NAME=apni_shadi
DB_USERNAME=apni_user
DB_PASSWORD=apni_password
MYSQL_ROOT_PASSWORD=change-this-local-root-password
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_JWT_EXPIRATION_MS=86400000
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini
